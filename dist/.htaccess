# Сгенерировано сборкой. Правьте content/*.json, а не этот файл.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. http -> https одним шагом (Бегет за nginx: проверяем все признаки https)
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://verhnyaya-pyshma.ekaterinburgbeton.ru%{REQUEST_URI} [R=301,L]

# 2. www -> основной хост
RewriteCond %{HTTP_HOST} ^www\.verhnyaya-pyshma\.ekaterinburgbeton\.ru$ [NC]
RewriteRule ^ https://verhnyaya-pyshma.ekaterinburgbeton.ru%{REQUEST_URI} [R=301,L]

# 3. /index.html, /index.htm, /index.php -> /
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.(?:html?|php)[\s?] [NC]
RewriteRule ^ https://verhnyaya-pyshma.ekaterinburgbeton.ru/%1 [R=301,L,NE]

# 4. отдельной страницы /catalog/ нет, полный прайс лежит в /price/
RewriteRule ^catalog/?$ https://verhnyaya-pyshma.ekaterinburgbeton.ru/price/ [R=301,L]

# 5. каталог без слэша на конце -> со слэшем, сразу на https основного хоста
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://verhnyaya-pyshma.ekaterinburgbeton.ru/$1/ [R=301,L]
</IfModule>

<IfModule mod_authz_core.c>
<FilesMatch "^(send\.config.*\.php|.*\.log|\.htaccess)$">
Require all denied
</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
<FilesMatch "^(send\.config.*\.php|.*\.log|\.htaccess)$">
Order allow,deny
Deny from all
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/ld+json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType application/xml "access plus 1 day"
</IfModule>
